rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // THE JOURNAL (page 3, read everywhere). Append only:
    // record once, never edited, never deleted.
    match /transactions/{id} {
      allow create, read: if request.auth != null;
      allow update, delete: if false;
    }

    // BILLS RECEIVABLE / BILLS PAYABLE (pages 19 and 20, folders pending).
    // Settlement edits allowed; the bill itself is never deleted.
    match /bills/{id} {
      allow create, read, update: if request.auth != null;
      allow delete: if false;
    }

    // THE REGISTERS (pages 21 to 40): orders, invoices, goods, notes,
    // vouchers, cheques, delivery notes, payroll, advances, assets.
    // update = settlement / status edits only; delete stays closed.
    match /orders/{id}        { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /invoices/{id}      { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /goods/{id}         { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /notes/{id}         { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /vouchers/{id}      { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /cheques/{id}       { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /deliveryNotes/{id} { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /payroll/{id}       { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /advances/{id}      { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /assets/{id}        { allow create, read, update: if request.auth != null; allow delete: if false; }

    // THE ACCRUAL REGISTERS (pages 49 to 52): accrued expenses,
    // prepaid expenses, accrued income, unearned revenue. Same treatment
    // as the registers: update for settlement or reversal status, no delete.
    match /accruedExpenses/{id} { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /prepaidExpenses/{id} { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /accruedIncome/{id}   { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /unearnedRevenue/{id} { allow create, read, update: if request.auth != null; allow delete: if false; }

    // ADJUSTMENTS AND RECONCILIATION INPUTS for the reports (pages 42 to 54).
    match /adjustments/{id} { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /bankrec/{id}     { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /suspense/{id}    { allow create, read, update: if request.auth != null; allow delete: if false; }

    // HEALTH: victim registration (page 322) and triage (page 323).
    // Append only, like the journal: create and read, never edited, never deleted.
    match /healthRegistrations/{id} {
      allow create, read: if request.auth != null;
      allow update, delete: if false;
    }
    match /healthTriage/{id} {
      allow create, read: if request.auth != null;
      allow update, delete: if false;
    }

    // EVERYTHING ELSE: closed. No collection may be used without a
    // matching rule above, so a new page needs its rule added here first.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
