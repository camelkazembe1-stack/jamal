rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // THE BOOKS: the journal, the bills and every register and report
    // input, pages 3 to 61. Every collection below gives a signed in
    // user the full rights - create, read, update (edit) and delete -
    // opened on the user's order of 25 October 2026. Before that day
    // the journal was append only and delete stayed closed.
    match /transactions/{id}    { allow create, read, update, delete: if request.auth != null; }
    match /bills/{id}           { allow create, read, update, delete: if request.auth != null; }
    match /orders/{id}          { allow create, read, update, delete: if request.auth != null; }
    match /invoices/{id}        { allow create, read, update, delete: if request.auth != null; }
    match /goods/{id}           { allow create, read, update, delete: if request.auth != null; }
    match /notes/{id}           { allow create, read, update, delete: if request.auth != null; }
    match /vouchers/{id}        { allow create, read, update, delete: if request.auth != null; }
    match /cheques/{id}         { allow create, read, update, delete: if request.auth != null; }
    match /deliveryNotes/{id}   { allow create, read, update, delete: if request.auth != null; }
    match /payroll/{id}         { allow create, read, update, delete: if request.auth != null; }
    match /advances/{id}        { allow create, read, update, delete: if request.auth != null; }
    match /assets/{id}          { allow create, read, update, delete: if request.auth != null; }
    match /accruedExpenses/{id} { allow create, read, update, delete: if request.auth != null; }
    match /prepaidExpenses/{id} { allow create, read, update, delete: if request.auth != null; }
    match /accruedIncome/{id}   { allow create, read, update, delete: if request.auth != null; }
    match /unearnedRevenue/{id} { allow create, read, update, delete: if request.auth != null; }
    match /adjustments/{id}     { allow create, read, update, delete: if request.auth != null; }
    match /bankrec/{id}         { allow create, read, update, delete: if request.auth != null; }
    match /suspense/{id}        { allow create, read, update, delete: if request.auth != null; }

    // HEALTH: victim registration (page 322) and triage (page 323).
    match /healthRegistrations/{id} { allow create, read, update, delete: if request.auth != null; }
    match /healthTriage/{id}        { allow create, read, update, delete: if request.auth != null; }

    // EVERYTHING ELSE: closed. A collection not named above is refused,
    // so a new page needs its rule added here first.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
