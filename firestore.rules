rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /transactions/{id} {
      allow create, read: if request.auth != null;
      allow update, delete: if false;
    }
    // Bills Receivable / Bills Payable books (pages 19-20).
    match /bills/{id} {
      allow create, read, update: if request.auth != null;
      allow delete: if false;
    }
    // Registers (pages 21-40): orders, invoices, goods, notes, vouchers,
    // cheques, delivery notes, payroll, advances, assets.
    // update = settlement / status edits only; delete stays closed.
    match /orders/{id}           { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /invoices/{id}         { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /goods/{id}            { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /notes/{id}            { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /vouchers/{id}         { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /cheques/{id}          { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /deliveryNotes/{id}    { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /payroll/{id}          { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /advances/{id}         { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /assets/{id}           { allow create, read, update: if request.auth != null; allow delete: if false; }
    // Adjustments + reconciliation inputs for the reports (pages 42-54).
    match /adjustments/{id}      { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /bankrec/{id}          { allow create, read, update: if request.auth != null; allow delete: if false; }
    match /suspense/{id}         { allow create, read, update: if request.auth != null; allow delete: if false; }
    // Health: victim registration (page 322) and triage assessments (page 323).
    // Append only, like the journal: create and read, never edited, never deleted.
    match /healthRegistrations/{id} { allow create, read: if request.auth != null; allow update, delete: if false; }
    match /healthTriage/{id}        { allow create, read: if request.auth != null; allow update, delete: if false; }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
