rules_version = '2';

// =====================================================================
// JAMALI — firestore.rules — the guard dog
// (Task 56: system accounts added; Task 61: multi-email administrator
// claim + registration notifications; TASK 64: the staff journey is
// GOOGLE-FREE)
//
// TASK 64 IN PLAIN WORDS: the administrator's Google sign-in is the
// ONLY house key. Staff register and log in with a username and a
// four-digit token, so their requests carry NO Google identity at all
// — every business collection is therefore open, exactly as the
// standing order intended. The system collections keep real guards:
// registration may only CREATE a pending, unbound account (never
// update, never delete, never touch the administrator's documents),
// and only the administrator — a real Google sign-in proven by the
// seeded claim — approves, edits grants or clears notifications.
// Anything not matched below is denied by default.
//
// The project's live collections, named by scanning every page's code:
//   transactions                — the one journal the whole business reads
//   healthRegistrations         — Registration (322)
//   healthTriage                — Triage (323)
//   healthNurseConsultations    — Nurse Consultation (324)
//   healthDoctorConsultations   — Doctor Consultation (325)
//   healthPrescriptions         — Pharmacy (326)
//   healthTreatmentOrders       — Treatment / Procedures (327)
//   healthDestinations          — the facility's destination list (325)
//   healthWards                 — Ward Registration (331)
//   healthBeds                  — Bed Management (332)
//   healthBedAssignments        — Bed Assignment (334) / Transfers (335)
//   healthBedTransfers          — Ward & Bed Transfers (335)
//   healthBedMaintenance        — Cleaning & Maintenance (336)
//   healthAdmissions            — Patient Admission (341-343)
//   healthDischarges            — Patient Discharge (350-353)
//   healthLabRequests           — Laboratory Management (360-363)
//   healthImagingRequests       — Radiology / Imaging (370-373)
//   systemNotifications         — Task 61: one notification per registration
//                                 request; the administrator's bell counter
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers (Task 56) ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isSystemAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/systemAdmins/$(request.auth.uid));
    }

    // ---- Business: one journal, every book derives from it ----
    // TASK 64: open — staff requests carry no Google identity (username
    // + token is the whole staff login; the administrator decides what
    // each staff account may see with the module selection).
    match /transactions/{docId} {
      allow create, read, update, delete: if true;
    }

    // ---- Health: one patient, one ID, one journey ----
    match /healthRegistrations/{docId} {
      allow create, read, update, delete: if true;
    }

    match /healthTriage/{docId} {
      allow create, read, update, delete: if true;
    }

    match /healthNurseConsultations/{docId} {
      allow create, read, update, delete: if true;
    }

    match /healthDoctorConsultations/{docId} {
      allow create, read, update, delete: if true;
    }

    match /healthPrescriptions/{docId} {
      allow create, read, update, delete: if true;
    }

    match /healthTreatmentOrders/{docId} {
      allow create, read, update, delete: if true;
    }

    match /healthDestinations/{docId} {
      allow create, read, update, delete: if true;
    }

    // ---- Health: wards, beds and placement (Task 52) ----
    match /healthWards/{docId} {
      allow create, read, update, delete: if true;
    }

    match /healthBeds/{docId} {
      allow create, read, update, delete: if true;
    }

    match /healthBedAssignments/{docId} {
      allow create, read, update, delete: if true;
    }

    match /healthBedTransfers/{docId} {
      allow create, read, update, delete: if true;
    }

    match /healthBedMaintenance/{docId} {
      allow create, read, update, delete: if true;
    }

    // ---- Health: admissions (Task 52) ----
    match /healthAdmissions/{docId} {
      allow create, read, update, delete: if true;
    }
    // ---- Health: discharge (Task 54) ----
    match /healthDischarges/{docId} {
      allow create, read, update, delete: if true;
    }

    // ---- Health: laboratory (Task 54) ----
    match /healthLabRequests/{docId} {
      allow create, read, update, delete: if true;
    }

    // ---- Health: radiology / imaging (Task 54) ----
    match /healthImagingRequests/{docId} {
      allow create, read, update, delete: if true;
    }


    // ---- Health: queue announcement settings (Task 53) ----
    // One document per service stage (triage, nurse, doctor, pharmacy,
    // treatment): the department, staff name, office and room the speaker
    // announcement reads aloud.
    match /healthQueueConfig/{docId} {
      allow create, read, update, delete: if true;
    }


    // ===================================================================
    // SYSTEM — accounts, credentials, administration
    // Two-key model, Task 64 edition: the Google sign-in is the key to
    // the HOUSE and only the administrator carries it; staff accounts
    // are room keys bound to NOTHING but their username — one staff per
    // username, many staff per email.
    // ===================================================================

    // ---- account profiles: usernames, positions, approval, grants ----
    // No secrets live here. Anyone may resolve a username — the staff
    // login itself is unauthenticated. Registration may only CREATE a
    // pending, UNBOUND profile (googleUid == "", role "user"); the
    // administrator claim escape below still seeds the first
    // administrator exactly as Task 56b built it. Only the
    // administrator approves, rejects, edits grants or deletes.
    match /systemAccounts/{docId} {
      allow read: if true;
      allow create: if (
        (request.resource.data.get("googleUid", "") == ""
          && request.resource.data.get("status", "") == "pending"
          && request.resource.data.get("role", "") == "user")
        || (request.auth != null
          && request.resource.data.get("googleUid", "") == request.auth.uid
          && request.resource.data.get("usernameLower", "") == "jamal kazembe"
          && request.resource.data.get("status", "") == "approved"
          && request.resource.data.get("role", "") == "admin"
          && request.resource.data.get("passHash", "") == "5c784bdcad7f92a39757e3ac0ae25315f422c4d97ef11cb438d059e9a830e9af"
          && request.resource.data.get("tokenHash", "") == "3f965d6df52296c4c2bf89878067be2c79cf6895189978f379746874728caae1"
          && !exists(/databases/$(database)/documents/systemSetup/claim))
      );
      allow update: if isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    // ---- credentials: password/token hashes + phone (never profile data) --
    // TASK 64: the staff login must read the token hash WITHOUT a Google
    // identity, so every credential document is readable EXCEPT the
    // administrator's own — that one stays bound to its Google identity
    // (its hashes are also sealed inside these rules). Creates may never
    // touch the administrator's document; updates stay
    // administrator/bound-identity only, so nobody can tamper with a
    // staff member's token once registered.
    match /systemCredentials/{docId} {
      allow read: if docId != "jamal kazembe"
        || (request.auth != null && resource.data.googleUid == request.auth.uid);
      allow create: if docId != "jamal kazembe"
        || (request.auth != null && request.resource.data.googleUid == request.auth.uid);
      allow update: if request.auth != null
        && (resource.data.googleUid == request.auth.uid || isSystemAdmin());
      allow delete: if isSystemAdmin();
    }

    // ---- administrators: one document per administrator google uid ----
    // The FIRST login with the administrator's username claims the role,
    // and — Task 61 (requirement 5) — the SAME credentials work from ANY
    // Google account: whoever presents BOTH exact salted hashes may create
    // their own administrator document (request.auth.uid cannot be forged,
    // and nobody without the real token/password can produce the hashes).
    match /systemAdmins/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.passHash == "5c784bdcad7f92a39757e3ac0ae25315f422c4d97ef11cb438d059e9a830e9af"
        && request.resource.data.tokenHash == "3f965d6df52296c4c2bf89878067be2c79cf6895189978f379746874728caae1";
      allow delete: if isSystemAdmin() && uid != request.auth.uid;
      allow update: if false;
    }

    // ---- setup marker: written once, by the claim, immutable after ----
    match /systemSetup/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/systemSetup/claim)
        && request.resource.data.passHash == "5c784bdcad7f92a39757e3ac0ae25315f422c4d97ef11cb438d059e9a830e9af"
        && request.resource.data.tokenHash == "3f965d6df52296c4c2bf89878067be2c79cf6895189978f379746874728caae1";
      allow update, delete: if false;
    }

    // ---- notifications (Task 61: requirements 9 + 10) ----
    // One document per registration request, written in the same batch as
    // the account itself. TASK 64: registration carries no Google
    // identity, so the create is guarded by SHAPE — a registration ring,
    // unread, unbound — instead of by the writer's identity. The
    // administrator reads the counter, dismisses entries, and a decision
    // marks the notification as read.
    match /systemNotifications/{docId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.get("type", "") == "registration"
        && request.resource.data.get("status", "") == "unread"
        && request.resource.data.get("googleUid", "") == "";
      allow update: if isSystemAdmin();
      allow delete: if isSystemAdmin();
    }

    // ---- page field configuration: hide existing fields / set defaults --
    // Read by every page that applies it (staff have no Google — the read
    // opens); written by the administrator only.
    match /systemPageConfig/{docId} {
      allow read: if true;
      allow create, update, delete: if isSystemAdmin();
    }

    // Everything not named above: denied. No block, no exceptions.
  }
}
